{
  "name": "outloud",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "tooling/*"],
  "scripts": {
    "setup": "bun install --frozen-lockfile && uv sync --locked",
    "dev": "turbo run dev --filter=@outloud/web --filter=@outloud/backend",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:web": "turbo run dev --filter=@outloud/web",
    "prototype:study": "bun run --cwd apps/web dev --port 5175 --strictPort",
    "dev:backend": "turbo run dev --filter=@outloud/backend",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "bun install --frozen-lockfile && turbo run test build lint check:deps --continue"
  },
  "devDependencies": {
    "turbo": "^2.11.6"
  }
}
